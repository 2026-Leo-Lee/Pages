    class Enemy {
      constructor(type, x, y) {
        this.type = type;
        this.x = x;
        this.y = y;
        this.facing = -1;
        this.hitFlash = 0;
        this.cooldown = 0;

        if (type === 'goblin') {
          this.name = "오염된 고블린";
          this.maxHp = 75;
          this.hp = 75;
          this.atk = 9;
          this.speed = 1.9;
          this.width = 32;
        } else if (type === 'centipede') {
          this.name = "거대 지네";
          this.maxHp = 150;
          this.hp = 150;
          this.atk = 16;
          this.speed = 2.2;
          this.width = 54;
        } else if (type === 'crystal') {
          this.name = "크리스탈 마수";
          this.maxHp = 190;
          this.hp = 190;
          this.atk = 20;
          this.speed = 1.3;
          this.width = 48;
        } else if (type === 'magma_boss') {
          this.name = "심연의 용암 지네 (BOSS)";
          this.maxHp = 650;
          this.hp = 650;
          this.atk = 28;
          this.speed = 1.8;
          this.width = 100;
        }
      }

      takeDamage(dmg, push) {
        this.hp -= dmg;
        this.hitFlash = 8;
        this.x += push * 12;
        addSparks(this.x, this.y - 30, 10, '#f43f5e');
        SoundFx.playHit();
        triggerShake(4, 6);

        if (this.hp <= 0) {
          player.gold += (this.type === 'magma_boss' ? 350 : 35);
          updateHUD();
          if (this.type === 'magma_boss') {
            player.shards = 4;
            showBanner('BOSS ANNIHILATED!', '장수 물약 회수 및 복수 완수!');
            document.getElementById('stageTitleText').textContent = '승리: 붉은 용의 원수를 갚고 영생의 비약을 되찾았습니다!';
          }
        }
      }

      update() {
        if (this.hp <= 0) return;
        if (this.hitFlash > 0) this.hitFlash--;

        const dist = player.x - this.x;
        this.facing = dist > 0 ? 1 : -1;

        if (Math.abs(dist) < 580) {
          if (Math.abs(dist) > 42) {
            this.x += this.facing * this.speed;
          } else {
            this.cooldown++;
            if (this.cooldown > 55) {
              this.cooldown = 0;
              if (!player.isInvincible && Math.hypot(player.x - this.x, player.y - this.y) < 62) {
                player.hp = Math.max(0, player.hp - this.atk);
                triggerShake(6, 9);
                addSparks(player.x, player.y - 30, 8, '#ef4444');
                updateHUD();
              }
            }
          }
        }
      }

      draw(ctx) {
        if (this.hp <= 0) return;
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.scale(this.facing, 1);

        ctx.fillStyle = 'rgba(0,0,0,0.65)';
        ctx.fillRect(-this.width/2, -66, this.width, 5);
        ctx.fillStyle = this.type === 'magma_boss' ? '#ef4444' : '#f43f5e';
        ctx.fillRect(-this.width/2, -66, this.width * (this.hp / this.maxHp), 5);

        const flash = this.hitFlash > 0;
        if (this.type === 'goblin') {
          ctx.fillStyle = flash ? '#fff' : '#166534';
          ctx.beginPath();
          ctx.roundRect(-10, -38, 20, 26, 4);
          ctx.fill();
          ctx.beginPath();
          ctx.arc(0, -42, 9, 0, Math.PI * 2);
          ctx.fill();
        } else if (this.type === 'centipede') {
          for (let i = 0; i < 4; i++) {
            ctx.fillStyle = flash ? '#fff' : (i === 0 ? '#78350f' : '#9a3412');
            ctx.beginPath();
            ctx.ellipse(-i * 12, -22, 10, 14, 0, 0, Math.PI * 2);
            ctx.fill();
          }
        } else if (this.type === 'crystal') {
          ctx.fillStyle = flash ? '#fff' : '#7c3aed';
          ctx.shadowColor = '#c084fc';
          ctx.shadowBlur = 10;
          ctx.beginPath();
          ctx.moveTo(0, -55);
          ctx.lineTo(18, -30);
          ctx.lineTo(8, 0);
          ctx.lineTo(-18, -15);
          ctx.closePath();
          ctx.fill();
          ctx.shadowBlur = 0;
        } else if (this.type === 'magma_boss') {
          ctx.shadowColor = '#dc2626';
          ctx.shadowBlur = 20;
          for (let i = 0; i < 6; i++) {
            ctx.fillStyle = flash ? '#fff' : (i % 2 === 0 ? '#991b1b' : '#ea580c');
            ctx.beginPath();
            ctx.ellipse(-i * 18, -35 + Math.sin(Date.now() * 0.005 + i) * 6, 17, 23, 0, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.shadowBlur = 0;
        }
        ctx.restore();
      }
    }

