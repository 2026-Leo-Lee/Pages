    function hitEnemies(range, damage, isAoE) {
      setTimeout(() => {
        for (const e of currentStage.enemies) {
          if (e.hp <= 0) continue;
          const dx = e.x - player.x;
          const inFront = isAoE || (player.facing === 1 ? dx > -10 : dx < 10);
          if (inFront && Math.abs(dx) < range) {
            e.takeDamage(damage, Math.sign(dx) || player.facing);
          }
        }
      }, 40);
    }

