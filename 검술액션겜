    function drawStageBackground() {
      const gY = currentStage.groundY;
      const theme = currentStage.bgTheme;

      const skyGrad = ctx.createLinearGradient(0, 0, 0, height);
      if (theme === 'forest') {
        skyGrad.addColorStop(0, '#0c0509');
        skyGrad.addColorStop(0.7, '#1a0b12');
        skyGrad.addColorStop(1, '#241018');
      } else if (theme === 'sky_ruins') {
        skyGrad.addColorStop(0, '#0a0815');
        skyGrad.addColorStop(0.6, '#18122c');
        skyGrad.addColorStop(1, '#2c1e45');
      } else if (theme === 'crystal_cave') {
        skyGrad.addColorStop(0, '#100518');
        skyGrad.addColorStop(0.6, '#1f0d2c');
        skyGrad.addColorStop(1, '#34134a');
      } else if (theme === 'magma_shrine') {
        skyGrad.addColorStop(0, '#140406');
        skyGrad.addColorStop(0.6, '#2e0a0f');
        skyGrad.addColorStop(1, '#480f14');
      }
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, width, height);

      // 패럴랙스 원경
      ctx.save();
      const p1 = camera.x * 0.2;
      ctx.fillStyle = theme === 'magma_shrine' ? '#20080b' : '#140a10';
      ctx.beginPath();
      ctx.moveTo(0, height * 0.8);
      for (let x = 0; x <= width + 60; x += 60) {
        const h = Math.sin((x + p1) * 0.008) * 80 + 130;
        ctx.lineTo(x, height * 0.8 - h);
      }
      ctx.lineTo(width, height);
      ctx.lineTo(0, height);
      ctx.closePath();
      ctx.fill();
      ctx.restore();

      // 바닥 및 발판
      ctx.save();
      ctx.translate(-camera.x, 0);

      if (currentStage.id !== 2) {
        const groundGrad = ctx.createLinearGradient(0, gY, 0, height);
        if (theme === 'magma_shrine') {
          groundGrad.addColorStop(0, '#4a1117');
          groundGrad.addColorStop(0.2, '#24090b');
          groundGrad.addColorStop(1, '#100405');
        } else {
          groundGrad.addColorStop(0, '#2e1219');
          groundGrad.addColorStop(0.1, '#190a0f');
          groundGrad.addColorStop(1, '#0c0507');
        }
        ctx.fillStyle = groundGrad;
        ctx.fillRect(-200, gY, currentStage.worldWidth + 400, height - gY);

        ctx.strokeStyle = theme === 'magma_shrine' ? '#e11d48' : '#881337';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.moveTo(-200, gY);
        ctx.lineTo(currentStage.worldWidth + 200, gY);
        ctx.stroke();
      } else {
        const abyssGrad = ctx.createLinearGradient(0, height * 0.8, 0, height);
        abyssGrad.addColorStop(0, 'rgba(244, 63, 94, 0.06)');
        abyssGrad.addColorStop(0.5, 'rgba(159, 18, 57, 0.35)');
        abyssGrad.addColorStop(1, '#050203');
        ctx.fillStyle = abyssGrad;
        ctx.fillRect(-200, height * 0.8, currentStage.worldWidth + 400, height * 0.3);
      }

      for (const plat of currentStage.platforms) {
        ctx.save();
        ctx.shadowColor = plat.color;
        ctx.shadowBlur = 12;
        ctx.fillStyle = plat.color;
        ctx.beginPath();
        ctx.roundRect(plat.x, plat.y, plat.w, plat.h, 6);
        ctx.fill();

        ctx.fillStyle = '#ffffff';
        ctx.globalAlpha = 0.45;
        ctx.fillRect(plat.x + 4, plat.y + 2, plat.w - 8, 3);
        ctx.restore();
      }

      if (currentStage.id === 2) {
        const portalX = 2280;
        const portalY = height * 0.50 - 55;
        ctx.save();
        ctx.shadowColor = '#f43f5e';
        ctx.shadowBlur = 28;
        ctx.fillStyle = '#f43f5e';
        ctx.beginPath();
        ctx.ellipse(portalX, portalY, 24, 46, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.ellipse(portalX, portalY, 14, 34, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      ctx.restore();
    }

    // 🗡️ [3번째 마검] 드로잉 엔진: 다중 가시 날개 코등이, 척추형 뼈마디 힐트, 톱니 블레이드, 붉은 악마의 눈
    function drawKnightSword(ctx) {
      ctx.save();
      const time = performance.now() * 0.004;

      // 1. 폼멜 (왕관 가시 장식)
      ctx.fillStyle = '#cbd5e1';
      ctx.beginPath();
      ctx.moveTo(-4, 16);
      ctx.lineTo(-6, 20);
      ctx.lineTo(-2, 18);
      ctx.lineTo(0, 22);
      ctx.lineTo(2, 18);
      ctx.lineTo(6, 20);
      ctx.lineTo(4, 16);
      ctx.closePath();
      ctx.fill();

      // 2. 뼈마디 척추 그립
      for (let i = 0; i < 4; i++) {
        const segY = 12 - i * 4;
        ctx.fillStyle = '#f8fafc';
        ctx.beginPath();
        ctx.roundRect(-2.5, segY - 3, 5, 3.2, 1.5);
        ctx.fill();
        ctx.strokeStyle = '#94a3b8';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }

      // 3. 다중 가시 날개 코등이 (3번째 검 특징)
      ctx.fillStyle = '#7f1d1d';
      ctx.strokeStyle = '#b91c1c';
      ctx.lineWidth = 1.2;

      // 좌측 날개
      ctx.beginPath();
      ctx.moveTo(-2, 0);
      ctx.quadraticCurveTo(-14, 4, -20, 8);
      ctx.quadraticCurveTo(-15, 0, -22, -6);
      ctx.quadraticCurveTo(-14, -4, -18, -12);
      ctx.quadraticCurveTo(-8, -6, -2, -2);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // 우측 날개
      ctx.beginPath();
      ctx.moveTo(2, 0);
      ctx.quadraticCurveTo(14, 4, 20, 8);
      ctx.quadraticCurveTo(15, 0, 22, -6);
      ctx.quadraticCurveTo(14, -4, 18, -12);
      ctx.quadraticCurveTo(8, -6, 2, -2);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // 날개 중앙 덮개
      ctx.fillStyle = '#450a0a';
      ctx.beginPath();
      ctx.ellipse(0, -3, 10, 6, 0, 0, Math.PI * 2);
      ctx.fill();

      // 4. 톱니형 블레이드
      const length = 68;
      ctx.save();
      ctx.shadowColor = '#f43f5e';
      ctx.shadowBlur = 14;

      ctx.beginPath();
      ctx.moveTo(0, -length);
      // 우측 날
      ctx.lineTo(4, -length + 10);
      ctx.lineTo(2, -length + 14);
      ctx.lineTo(6, -length + 22);
      ctx.lineTo(4, -length + 26);
      ctx.lineTo(6.5, -length + 38);
      ctx.lineTo(3.5, -length + 44);
      ctx.lineTo(7, -length + 54);
      ctx.lineTo(2.5, -3);
      // 좌측 날
      ctx.lineTo(-2.5, -3);
      ctx.lineTo(-7, -length + 54);
      ctx.lineTo(-3.5, -length + 44);
      ctx.lineTo(-6.5, -length + 38);
      ctx.lineTo(-4, -length + 26);
      ctx.lineTo(-6, -length + 22);
      ctx.lineTo(-2, -length + 14);
      ctx.lineTo(-4, -length + 10);
      ctx.closePath();

      const bladeGrad = ctx.createLinearGradient(-7, 0, 7, -length);
      bladeGrad.addColorStop(0, '#4c0519');
      bladeGrad.addColorStop(0.4, '#881337');
      bladeGrad.addColorStop(0.7, '#be123c');
      bladeGrad.addColorStop(1, '#fda4af');
      ctx.fillStyle = bladeGrad;
      ctx.fill();

      ctx.strokeStyle = '#f43f5e';
      ctx.lineWidth = 1.2;
      ctx.stroke();
      ctx.restore();

      // 중앙 다이아몬드 홈
      ctx.fillStyle = '#1c070c';
      ctx.beginPath();
      ctx.moveTo(0, -length + 26);
      ctx.lineTo(2.5, -length + 31);
      ctx.lineTo(0, -length + 36);
      ctx.lineTo(-2.5, -length + 31);
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = '#e11d48';
      ctx.lineWidth = 0.8;
      ctx.stroke();

      // 5. 붉은 악마의 눈동자 (실시간 안광)
      const eyeY = -length + 46;
      ctx.save();
      ctx.fillStyle = '#fff1f2';
      ctx.beginPath();
      ctx.ellipse(0, eyeY, 4, 6.5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#4c0519';
      ctx.lineWidth = 0.8;
      ctx.stroke();

      const pupilPulse = Math.sin(time) * 0.4;
      const eyeGrad = ctx.createRadialGradient(0, eyeY, 0.5, 0, eyeY, 3.5);
      eyeGrad.addColorStop(0, '#ff0033');
      eyeGrad.addColorStop(0.6, '#b91c1c');
      eyeGrad.addColorStop(1, '#450a0a');

      ctx.fillStyle = eyeGrad;
      ctx.beginPath();
      ctx.arc(0, eyeY, 3.2 + pupilPulse * 0.3, 0, Math.PI * 2);
      ctx.shadowColor = '#ff0033';
      ctx.shadowBlur = 10;
      ctx.fill();

      ctx.fillStyle = '#050203';
      ctx.beginPath();
      ctx.ellipse(0, eyeY, 1.2, 2.4, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(-1, eyeY - 1.5, 0.9, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      ctx.restore();
    }

    function drawPlayer(ctx, x, y, facing) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(facing, 1);

      ctx.beginPath();
      ctx.ellipse(0, 0, 24, 8, 0, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(0,0,0,0.45)';
      ctx.fill();

      if (customHeroImg) {
        ctx.save();
        ctx.translate(0, -45);
        const aspect = customHeroImg.width / customHeroImg.height;
        const h = 82;
        const w = h * aspect;
        ctx.drawImage(customHeroImg, -w/2, -h/2, w, h);

        ctx.translate(14, 10);
        ctx.rotate(player.swordAngle);
        drawKnightSword(ctx);
        ctx.restore();
        ctx.restore();
        return;
      }

      ctx.translate(0, -38);

      // 망토
      ctx.fillStyle = '#450a0a';
      ctx.beginPath();
      ctx.moveTo(-8, -10);
      const flow = Math.sin(player.legPhase) * 6 - (player.vx * facing * 2);
      ctx.quadraticCurveTo(-24 + flow, 14, -16 + flow, 36);
      ctx.lineTo(-4, 32);
      ctx.closePath();
      ctx.fill();

      const legSpread = (player.state === 'RUN') ? Math.sin(player.legPhase) * 12 : 3;
      ctx.strokeStyle = '#18070b';
      ctx.lineWidth = 6;
      ctx.beginPath();
      ctx.moveTo(-4, 12);
      ctx.lineTo(-6 - legSpread, 36);
      ctx.stroke();

      ctx.strokeStyle = '#270e14';
      ctx.beginPath();
      ctx.moveTo(4, 12);
      ctx.lineTo(6 + legSpread, 36);
      ctx.stroke();

      // 갑옷
      ctx.fillStyle = '#1c080d';
      ctx.beginPath();
      ctx.roundRect(-11, -16, 22, 30, 4);
      ctx.fill();

      ctx.fillStyle = '#e11d48';
      ctx.fillRect(-4, -10, 8, 8);

      // 투구
      ctx.fillStyle = '#2b0c13';
      ctx.beginPath();
      ctx.arc(0, -26, 12, 0, Math.PI * 2);
      ctx.fill();

      // 투구 안광
      ctx.fillStyle = '#f43f5e';
      ctx.shadowColor = '#e11d48';
      ctx.shadowBlur = 8;
      ctx.fillRect(2, -28, 7, 3);
      ctx.shadowBlur = 0;

      // 팔 및 3번째 검
      ctx.save();
      ctx.translate(4, -8);
      ctx.rotate(player.armAngle);

      ctx.strokeStyle = '#2b0c13';
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(16, 0);
      ctx.stroke();

      ctx.translate(16, 0);
      ctx.rotate(player.swordAngle);
      drawKnightSword(ctx);

      ctx.restore();
      ctx.restore();
    }

    function update() {
      let moveDir = 0;
      if (keys['a'] || keys['arrowleft']) moveDir -= 1;
      if (keys['d'] || keys['arrowright']) moveDir += 1;

      const finalMove = moveDir !== 0 ? moveDir : input.x;

      const now = performance.now();
      const sweepCdEl = document.getElementById('sweepCooldownDisplay');
      if (now < player.sweepCooldown) {
        const remain = ((player.sweepCooldown - now) / 1000).toFixed(1);
        sweepCdEl.classList.remove('hidden');
        sweepCdEl.classList.add('flex');
        sweepCdEl.textContent = `${remain}s`;
      } else {
        sweepCdEl.classList.add('hidden');
        sweepCdEl.classList.remove('flex');
      }

      if (player.mp < player.maxMp) {
        player.mp = Math.min(player.maxMp, player.mp + 0.15);
        updateHUD();
      }

      const isAttacking = ['SLASH_1', 'SLASH_2', 'THRUST', 'SWEEP'].includes(player.state);

      if (player.state === 'DASH') {
        player.stateTimer++;
        player.x += player.vx;
        player.vx *= 0.88;
        if (player.stateTimer % 2 === 0) {
          player.ghosts.push({ x: player.x, y: player.y, facing: player.facing, alpha: 0.6 });
        }
        if (player.stateTimer > 14) {
          player.state = 'IDLE';
          player.isInvincible = false;
        }
      } else if (isAttacking) {
        player.stateTimer++;
        player.x += player.vx;
        player.vx *= 0.8;

        if (player.state === 'SWEEP') {
          player.armAngle = (player.stateTimer / 18) * Math.PI * 4;
          player.swordAngle = 1.2;
          if (player.stateTimer > 20) player.state = 'IDLE';
        } else if (player.state === 'SLASH_1') {
          const p = Math.min(player.stateTimer / 13, 1.0);
          player.armAngle = (p < 0.3) ? -0.8 : -0.8 + (p - 0.3) * 3.4;
          player.swordAngle = player.armAngle + 1.2;
          if (player.stateTimer >= 14) player.state = 'IDLE';
        } else if (player.state === 'SLASH_2') {
          const p = Math.min(player.stateTimer / 15, 1.0);
          player.armAngle = (p < 0.25) ? -2.2 : -2.2 + (p - 0.25) * 4.4;
          player.swordAngle = player.armAngle + 0.6;
          if (player.stateTimer >= 16) player.state = 'IDLE';
        } else if (player.state === 'THRUST') {
          player.armAngle = 0.05;
          player.swordAngle = 0.02;
          if (player.stateTimer >= 16) player.state = 'IDLE';
        }
      } else {
        if (Math.abs(finalMove) > 0.15) {
          player.facing = finalMove > 0 ? 1 : -1;
          player.vx = finalMove * player.speed;
          player.x += player.vx;
          player.legPhase += 0.22;
          if (player.isGrounded) player.state = 'RUN';
        } else {
          player.vx = 0;
          player.legPhase += 0.04;
          if (player.isGrounded) player.state = 'IDLE';
        }

        if (player.isGrounded) {
          player.armAngle = -0.2 + Math.sin(player.legPhase) * 0.1;
          player.swordAngle = -0.7 + Math.sin(player.legPhase) * 0.05;
        }
      }

      player.vy += 0.75;
      const prevY = player.y;
      player.y += player.vy;
      player.isGrounded = false;

      for (const plat of currentStage.platforms) {
        if (player.x >= plat.x - 12 && player.x <= plat.x + plat.w + 12) {
          if (prevY <= plat.y && player.y >= plat.y) {
            player.y = plat.y;
            player.vy = 0;
            player.isGrounded = true;
            if (!isAttacking && player.state !== 'DASH') player.state = 'IDLE';
            break;
          }
        }
      }

      if (currentStage.id !== 2 && player.y >= currentStage.groundY) {
        player.y = currentStage.groundY;
        player.vy = 0;
        player.isGrounded = true;
        if (!isAttacking && player.state !== 'DASH') player.state = 'IDLE';
      }

      if (currentStage.id === 2) {
        if (player.y > currentStage.hazardY) {
          player.hp = Math.max(10, player.hp - 20);
          showBanner('FALLEN INTO ABYSS!', '낙하! 시작 지점으로 복귀합니다.');
          triggerShake(8, 12);
          updateHUD();
          player.x = player.spawnX;
          player.y = player.spawnY;
          player.vy = 0;
        }

        if (player.x > 2240) {
          showBanner('STAGE CLEAR!', '부유 절벽을 돌파하였습니다!');
          setTimeout(() => toggleWorldMap(), 900);
        }
      }

      player.x = Math.max(30, Math.min(currentStage.worldWidth, player.x));

      for (let i = player.ghosts.length - 1; i >= 0; i--) {
        player.ghosts[i].alpha -= 0.07;
        if (player.ghosts[i].alpha <= 0) player.ghosts.splice(i, 1);
      }

      camera.update(player.x);
      companion.update();
      for (const e of currentStage.enemies) e.update();
    }

    function gameLoop() {
      update();

      ctx.save();
      if (screenShake.duration > 0) {
        const sx = (Math.random() - 0.5) * screenShake.intensity;
        const sy = (Math.random() - 0.5) * screenShake.intensity;
        ctx.translate(sx, sy);
        screenShake.duration--;
      }

      drawStageBackground();

      ctx.save();
      ctx.translate(-camera.x, 0);

      for (const g of player.ghosts) {
        ctx.save();
        ctx.globalAlpha = g.alpha * 0.4;
        drawPlayer(ctx, g.x, g.y, g.facing);
        ctx.restore();
      }

      companion.draw(ctx);
      for (const e of currentStage.enemies) e.draw(ctx);
