    function findNearestEnemy(srcX, maxR) {
      let target = null;
      let minD = maxR;
      for (const e of currentStage.enemies) {
        if (e.hp > 0) {
          const d = Math.abs(e.x - srcX);
          if (d < minD) {
            minD = d;
            target = e;
          }
        }
      }
      return target;
    }

    const particles = [];
    const bladeWaves = [];

    function addBladeWave(x, y, angle, radius, color, isSweep = false, isThrust = false) {
      bladeWaves.push({
        x, y, angle, radius,
        maxRadius: radius * (isSweep ? 1.9 : 1.4),
        opacity: 1.0,
        color,
        isSweep,
        isThrust,
        decay: isSweep ? 0.05 : 0.065
      });
    }

    function addSparks(x, y, count = 10, color = '#f43f5e') {
      for (let i = 0; i < count; i++) {
        const speed = 2 + Math.random() * 6.5;
        const ang = Math.random() * Math.PI * 2;
        particles.push({
          x, y,
          vx: Math.cos(ang) * speed,
          vy: Math.sin(ang) * speed,
          size: 2 + Math.random() * 3.5,
          color,
          alpha: 1.0,
          decay: 0.04 + Math.random() * 0.03
        });
      }
    }

    function doSlash() {
      if (player.state === 'DASH') return;
      SoundFx.init();
      SoundFx.playSlash();

      const now = performance.now();
      if (now - player.lastAttackTime < 750 && player.comboCount === 1) {
        player.state = 'SLASH_2';
        player.stateTimer = 0;
        player.comboCount = 2;
        player.vx = player.facing * 4.5;
        showBanner('2ND CRIMSON OVERHEAD', '2 HITS!');
        addBladeWave(player.x + player.facing * 35, player.y - 30, player.facing === 1 ? 0.7 : 2.4, 56, '#e11d48');
        hitEnemies(90, 42, false);
      } else {
        player.state = 'SLASH_1';
        player.stateTimer = 0;
        player.comboCount = 1;
        player.vx = player.facing * 3.5;
        showBanner('1ST CRIMSON CLEAVE', '1 HIT');
        addBladeWave(player.x + player.facing * 30, player.y - 25, player.facing === 1 ? -0.2 : 3.3, 50, '#f43f5e');
        hitEnemies(80, 34, false);
      }
      player.lastAttackTime = now;
    }

    function doThrust() {
      if (player.state === 'DASH') return;
      SoundFx.init();
      SoundFx.playThrust();

      player.state = 'THRUST';
      player.stateTimer = 0;
      player.comboCount = 3;
      player.vx = player.facing * 14.5;
      player.lastAttackTime = performance.now();
      showBanner('CRIMSON EYE PIERCE', 'PIERCE CRITICAL!');
      triggerShake(5, 8);

      addBladeWave(player.x + player.facing * 48, player.y - 22, player.facing === 1 ? 0 : Math.PI, 75, '#fb7185', false, true);
      hitEnemies(130, 52, false);
    }

    function doSweep() {
      const now = performance.now();
      if (now < player.sweepCooldown) return;
      if (player.mp < 25) {
        showBanner('NOT ENOUGH MANA', '기력(MP) 부족!');
        return;
      }

      SoundFx.init();
      SoundFx.playSweep();

      player.mp -= 25;
      player.sweepCooldown = now + player.sweepMaxCooldown;
      player.state = 'SWEEP';
      player.stateTimer = 0;
      player.comboCount = 4;
      showBanner('BLOOD-EYE VORTEX [E]', 'ANNIHILATION SWEEP!');
      triggerShake(8, 14);

      addBladeWave(player.x, player.y - 30, 0, 105, '#e11d48', true);
      addBladeWave(player.x, player.y - 30, Math.PI, 105, '#9f1239', true);
      hitEnemies(155, 85, true);
      updateHUD();
    }

    function doJump() {
      if (player.isGrounded && player.state !== 'DASH') {
        SoundFx.init();
        SoundFx.playJump();
        player.vy = -14.2;
        player.isGrounded = false;
        player.state = 'JUMP';
      }
    }

    function doDash() {
      if (player.state === 'DASH') return;
      player.state = 'DASH';
      player.stateTimer = 0;
      player.isInvincible = true;
      player.vx = player.facing * 16;
      triggerShake(3, 5);
      addSparks(player.x, player.y - 20, 9, '#f43f5e');
